# Copy this file to .env.local and fill in your Supabase credentials.
# Dashboard → Settings → API → "Project URL" and "Publishable key" (a.k.a. anon key).
# Do NOT commit .env.local; it is gitignored.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR-PUBLISHABLE-KEY

# Sentry (optional). Leave blank in dev — Sentry init no-ops without a DSN.
# Frontend (Vite): exposed to client bundle.
VITE_SENTRY_DSN=
# Backend (Node): server-side error reporting.
SENTRY_DSN=
