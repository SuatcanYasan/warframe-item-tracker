{
  "name": "warframe-item-tracker",
  "version": "2.2.0",
  "description": "Warframe Item Tracker — Craft, Relic & Inventory tracking with Express API and React + Vite frontend",
  "main": "src/server.js",
  "scripts": {
    "setup": "npm install",
    "snapshot": "node scripts/build-items-snapshot.mjs",
    "start": "node src/server.js",
    "dev": "concurrently \"cross-env PORT=3001 node --watch src/server.js\" \"vite --config web/vite.config.mjs\"",
    "build": "vite build --config web/vite.config.mjs",
    "build:all": "npm run snapshot && npm run build",
    "preview": "vite preview --config web/vite.config.mjs",
    "easy": "npm run build && npm start",
    "test": "node --test tests/craftCalculator.test.js"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@formkit/auto-animate": "^0.9.0",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.23",
    "antd": "^5.28.0",
    "dayjs": "^1.11.20",
    "express": "^4.21.2",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.3.0",
    "hotkeys-js": "^4.0.3",
    "html-to-image": "^1.11.13",
    "i18next": "^26.0.3",
    "immer": "^11.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "vite-plugin-pwa": "^1.2.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "vite": "^5.4.19"
  }
}
