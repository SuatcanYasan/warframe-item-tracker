{
  "name": "warframe-todo",
  "version": "1.0.0",
  "description": "Warframe craft requirement tracker with Express API and React + Vite frontend",
  "main": "src/server.js",
  "scripts": {
    "setup": "npm install",
    "snapshot": "node scripts/build-items-snapshot.mjs",
    "start": "node src/server.js",
    "dev": "concurrently \"cross-env PORT=3001 node --watch src/server.js\" \"vite --config web/vite.config.mjs\"",
    "build": "vite build --config web/vite.config.mjs",
    "build:all": "npm run snapshot && npm run build",
    "preview": "vite preview --config web/vite.config.mjs",
    "easy": "npm run build && npm start",
    "test": "node --test tests/craftCalculator.test.js"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.1",
    "antd": "^5.28.0",
    "express": "^4.21.2",
    "framer-motion": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "vite": "^5.4.19"
  }
}
